<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="RnKeyboardShortcutRow" parent="AdwActionRow">
    <child type="prefix">
      <object class="RnKeybindingButton" id="keybinding_button">
        <property name="valign">center</property>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkDropDown" id="penstyle_dropdown">
        <property name="halign">end</property>
        <property name="valign">center</property>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkDropDown" id="mode_dropdown">
        <property name="halign">end</property>
        <property name="valign">center</property>
        <property name="model">
          <object class="GtkStringList">
            <items>
              <item translatable="yes">Temporary</item>
              <item translatable="yes">Permanent</item>
              <item translatable="yes">Toggle</item>
              <item translatable="yes">Disabled</item>
            </items>
          </object>
        </property>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkDropDown" id="shape_builder_dropdown">
        <property name="halign">end</property>
        <property name="valign">center</property>
        <property name="visible">false</property>
        <property name="model">
          <object class="GtkStringList">
            <items>
              <item translatable="yes">Line</item>
              <item translatable="yes">Arrow</item>
              <item translatable="yes">Rectangle</item>
              <item translatable="yes">Ellipse</item>
            </items>
          </object>
        </property>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkButton" id="delete_button">
        <property name="icon-name">user-trash-symbolic</property>
        <property name="valign">center</property>
        <property name="tooltip-text" translatable="yes">Remove this shortcut</property>
      </object>
    </child>
  </template>
</interface>
